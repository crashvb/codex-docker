#!/bin/bash

set -e -o pipefail

# Configure: codex
if [[ ! -e "${EP_RUN}" ]] ; then
	log "Configuring $(basename "${0}") for first run ..."

	/opt/codex/setup_universal.sh

	if [[ -n "${SEARXNG_URL:-}" ]] && ! codex mcp get searxng --json > /dev/null 2>&1 ; then
		log "Registering SearXNG MCP server: ${SEARXNG_URL} ..."
		codex mcp add searxng --env "SEARXNG_URL=${SEARXNG_URL}" -- mcp-searxng
	fi
fi

